# Configuration example. Copy to .env (gitignored) and fill in locally.
# Never commit .env, provider keys or brokerage credentials.
VITE_API_BASE_URL=http://127.0.0.1:8000
SIW_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost
SIW_DATA_DIR=data

# Market data provider: fake (synthetic, default) or alpaca (opt-in prototype).
SIW_MARKET_DATA_PROVIDER=fake

# Alpaca Market Data API v2 (read-only bars). Keys from the Alpaca dashboard;
# paper-account keys are enough for market data.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# sip: consolidated tape; the free plan excludes the latest 15 minutes.
# iex: IEX exchange only (a small share of volume), real time on the free plan.
SIW_ALPACA_FEED=sip
# SYMBOL:MIC pairs served by the adapter.
SIW_ALPACA_SYMBOLS=SPY:ARCX,AAPL:XNAS,MSFT:XNAS
# Minutes after a bar ends before this account can see it (default 15 for sip, 0 for iex).
# SIW_ALPACA_DELAY_MINUTES=15
# Minutes after a bar ends before it is treated as final.
# SIW_ALPACA_FINALITY_MINUTES=15
# SIW_ALPACA_DATA_URL=https://data.alpaca.markets

# Broker market-data adapters (read-only; order endpoints are structurally blocked).
# Use with SIW_MARKET_DATA_PROVIDER=kis | toss | kiwoom. Sessions default to regular
# hours until each broker's extended-hours coverage is confirmed with broker_check.
# 한국투자증권 KIS Developers (each token issuance sends a KakaoTalk notice).
SIW_KIS_APP_KEY=
SIW_KIS_APP_SECRET=
# SIW_KIS_SYMBOLS=SPY:ARCX,AAPL:XNAS,MSFT:XNAS
# SIW_KIS_SESSIONS=regular
# SIW_KIS_TIMESTAMP_IS_BAR_END=false
# 토스증권 Open API (register this machine's IP on the Open API allowlist).
SIW_TOSS_CLIENT_ID=
SIW_TOSS_CLIENT_SECRET=
# SIW_TOSS_SYMBOLS=SPY:ARCX,AAPL:XNAS,MSFT:XNAS
# SIW_TOSS_SESSIONS=regular
# 키움증권 REST API (the cntr_tm time zone is undocumented: confirm with broker_check).
SIW_KIWOOM_APP_KEY=
SIW_KIWOOM_SECRET_KEY=
SIW_KIWOOM_TIME_ZONE=
# SIW_KIWOOM_SYMBOLS=SPY:ARCX,AAPL:XNAS,MSFT:XNAS
# SIW_KIWOOM_SESSIONS=regular
# 메리츠증권 Open API (public beta from 2026-10-12, GA 2026-10-26). Every call must send
# this machine's MAC address (12 hex characters), as the API requires. Minute bars cover
# only the latest 40 bars; older minutes are reported as beyond_source_history.
SIW_MERITZ_APP_KEY=
SIW_MERITZ_APP_SECRET=
SIW_MERITZ_MAC_ADDRESS=
# SIW_MERITZ_SYMBOLS=SPY:ARCX,AAPL:XNAS,MSFT:XNAS
# SIW_MERITZ_SESSIONS=regular
# SIW_MERITZ_DELAYED=false
# SIW_MERITZ_TIMESTAMP_IS_BAR_END=false
