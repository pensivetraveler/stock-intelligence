{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SIW_DATA_DIR=data/browser-preview",
        "uv",
        "run",
        "uvicorn",
        "services.api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@siw/desktop", "dev:web"],
      "port": 5173
    }
  ]
}
