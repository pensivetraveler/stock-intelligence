{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIW Agent",
  "version": "0.4.0-dev",
  "identifier": "com.pensivetraveler.siw.agent",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:agent",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "corepack pnpm build:agent",
    "frontendDist": "../dist-agent"
  },
  "app": {
    "windows": [
      {
        "title": "SIW Agent — 전략 실행",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["app"]
  }
}
