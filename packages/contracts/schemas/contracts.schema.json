        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportedExecution"
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LedgerPosition"
          }
        },
